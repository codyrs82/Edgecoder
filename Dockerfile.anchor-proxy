FROM node:25-bookworm-slim@sha256:81db02c4b671288a03915da9534dbd54f96d0e7c24d80ccc54f5b36b2e684370

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
RUN npm ci --ignore-scripts

COPY tsconfig.json ./
COPY src ./src

RUN npm run build && npm prune --omit=dev

EXPOSE 4311

# #5: services default to 127.0.0.1; containers must listen on all interfaces.
ENV HOST=0.0.0.0
# Holds the bitcoind RPC credentials: run unprivileged, like Dockerfile.agent and Dockerfile.server
# (the app files stay root-owned, so the process cannot change its own code).
USER node
CMD ["node", "dist/economy/anchor-proxy-service.js"]
