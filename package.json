{
  "name": "edgecoder",
  "version": "1.0.0",
  "description": "EdgeCoder on-device and swarm runtime scaffold",
  "main": "dist/index.js",
  "bin": {
    "edgecoder": "dist/cli/edgecoder.js",
    "edgecoder-agent": "dist/cli/edgecoder-agent.js",
    "edgecoder-coordinator": "dist/cli/edgecoder-coordinator.js",
    "edgecoder-portal": "dist/cli/edgecoder-portal.js",
    "edgecoder-install": "dist/cli/edgecoder-install.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:alt": "INFERENCE_PORT=4312 COORDINATOR_PORT=4311 CONTROL_PLANE_PORT=4313 INFERENCE_URL=http://127.0.0.1:4312 COORDINATOR_URL=http://127.0.0.1:4311 tsx src/index.ts",
    "dev:coordinator": "tsx src/swarm/coordinator.ts",
    "dev:inference": "tsx src/inference/service.ts",
    "dev:control": "tsx src/control-plane/server.ts",
    "dev:portal": "tsx src/portal/server.ts",
    "dev:ide": "tsx src/apps/ide/provider-server.ts",
    "dev:worker": "tsx src/swarm/worker-runner.ts",
    "dev:worker:ios": "tsx src/swarm/ios-agent.ts",
    "bootstrap:coordinator": "tsx src/bootstrap/coordinator.ts",
    "verify:blacklist-audit": "tsx src/bootstrap/verify-blacklist-audit.ts",
    "build": "tsc -p tsconfig.json",
    "build:macos-installer": "bash scripts/macos/build-installer.sh",
    "install:macos-local": "bash scripts/macos/install-local.sh",
    "build:linux-deb": "bash scripts/linux/build-deb.sh",
    "build:windows-msi": "bash scripts/windows/build-msi.sh",
    "build:ble-proxy": "bash scripts/macos/build-ble-proxy.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.e2e.config.ts",
    "test:lnd-regtest": "bash scripts/e2e/lnd-regtest.sh",
    "docs:dev": "vitepress dev site-docs",
    "docs:build": "vitepress build site-docs",
    "site:export": "tsx scripts/export-static-site.ts",
    "docs:preview": "vitepress preview site-docs",
    "model:list": "tsx bin/swap-model.ts list",
    "model:swap": "tsx bin/swap-model.ts swap",
    "model:status": "tsx bin/swap-model.ts status",
    "model:pull": "tsx bin/swap-model.ts pull",
    "models:verify-catalog": "tsx scripts/check-model-catalog.ts",
    "models:sync-catalog": "node scripts/sync-model-catalog.mjs",
    "test:e2e": "npx playwright test --config tests/e2e/playwright.config.ts",
    "test:e2e:up": "docker compose -f tests/e2e/docker-compose.e2e.yml up -d --build",
    "test:e2e:down": "docker compose -f tests/e2e/docker-compose.e2e.yml down -v",
    "check:scripts": "node scripts/check-scripts.mjs",
    "check:fly-configs": "node scripts/check-fly-configs.mjs",
    "fly:bootstrap": "bash scripts/fly-bootstrap-org.sh",
    "test:desktop-ui": "cd desktop && npx playwright test --config e2e/playwright.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "BUSL-1.1",
  "type": "module",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/websocket": "^11.2.0",
    "@noble/curves": "2.0.1",
    "@scure/base": "^2.0.0",
    "@simplewebauthn/server": "^13.2.2",
    "acorn": "^8.16.0",
    "better-sqlite3": "^12.6.2",
    "fastify": "^5.7.4",
    "lightweight-charts": "^4.2.3",
    "pg": "^8.18.0",
    "undici": "^7.22.0",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "@abandonware/bleno": "^0.6.2",
    "@abandonware/noble": "^1.9.2-26"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.16.0",
    "@types/web-bluetooth": "^0.0.21",
    "@types/ws": "^8.18.1",
    "mermaid": "^11.12.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22.12 <25"
  },
  "packageManager": "npm@10.9.2",
  "overrides": {
    "tar": "^7.5.22",
    "@mapbox/node-pre-gyp": "^2.0.3",
    "node-gyp": "^11.5.0",
    "glob": "^14.0.3",
    "mermaid": {
      "katex": "^0.18.2"
    },
    "vitepress": {
      "vite": "^6.4.1"
    }
  }
}
