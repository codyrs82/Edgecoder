# syntax=docker/dockerfile:1
# #9: slim, non-root server image for every non-agent role (docs/packages.md): all-in-one (seed),
# coordinator, portal, control-plane, inference. The role is EDGE_RUNTIME_MODE (default
# all-in-one) or the first argument: `docker run edgecoder-server portal`.
# No Ollama or BLE here (the agent image has them). No compilers, no tests/, prod deps only.
# Build from the repo root: docker build -f deploy/docker/Dockerfile.server .
FROM node:22-bookworm-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d AS build
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ && rm -rf /var/lib/apt/lists/*
COPY package*.json ./
# BLE modules are optionalDependencies; they are not needed (and not built) here.
RUN npm ci --omit=optional
COPY tsconfig.json ./
COPY src ./src
# #89: the portal serves the shared design tokens; `npm run build` copies them to dist/portal/assets.
COPY scripts/copy-portal-assets.mjs ./scripts/
COPY packages/tokens/dist/tokens.css ./packages/tokens/dist/
RUN npm run build && npm prune --omit=dev --omit=optional

FROM node:22-bookworm-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d AS runtime
ARG EDGE_RUNTIME_MODE=all-in-one
ENV NODE_ENV=production HOST=0.0.0.0 EDGE_RUNTIME_MODE=$EDGE_RUNTIME_MODE
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tini && rm -rf /var/lib/apt/lists/*
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist ./dist
COPY --chown=node:node package.json ./
COPY --chown=node:node deploy/install.sh deploy/install.ps1 ./deploy/
USER node
EXPOSE 4301 4302 4303 4304 4310
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "dist/cli/edgecoder.js"]
