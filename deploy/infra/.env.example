# EdgeCoder infrastructure node bundle: deploy/infra/.env
# scripts/infra-bootstrap.sh copies this file to .env, fills the secrets and the derived
# values, and keeps whatever you set afterwards. Variable table: src/install/infra-role.ts
# (tests/install/infra-role.test.ts fails if this file and that table disagree).
# Values are read by docker compose: no quotes, no `$`, one line each.

# ---- Chain ------------------------------------------------------------------------------
# bitcoin | testnet | signet. The coordinator anchors checkpoints on this chain; lnd and
# electrs follow it. Start on signet; switch to bitcoin with a fresh set of volumes.
BITCOIN_NETWORK=signet
# Derived from BITCOIN_NETWORK by the bootstrap (bitcoind chain= : main | test | signet).
BITCOIN_CHAIN=signet
# Derived from BITCOIN_NETWORK by the bootstrap (lnd network and macaroon directory).
LND_NETWORK=signet
# Derived from BITCOIN_NETWORK by the bootstrap: P2P port published on the host and to open
# in the firewall (8333 mainnet, 18333 testnet, 38333 signet).
BITCOIN_P2P_PORT=38333
# 0 keeps the whole chain (needed for the indexer profile). Otherwise a prune target in MiB,
# at least 550; 50000 keeps the last ~50 GB of blocks on mainnet.
BITCOIN_PRUNE=0
# UTXO cache in MiB. 2000 is fine for a 8 GB host; raise it for a faster initial sync.
BITCOIN_DBCACHE=2000

# ---- bitcoind RPC (compose network only; never published) --------------------------------
BITCOIND_RPC_USER=edgecoder
# Generated by the bootstrap. The rpcauth line in generated/bitcoin.conf is derived from it.
BITCOIND_RPC_PASSWORD=
# Generated by the bootstrap: 16-byte hex salt for the rpcauth HMAC.
BITCOIND_RPCAUTH_SALT=
# Wallet the coordinator anchors from (OP_RETURN checkpoints). The bootstrap creates it.
BITCOIND_WALLET_NAME=edgecoder-anchor

# ---- lnd ---------------------------------------------------------------------------------
# Alias shown on the Lightning network.
LND_ALIAS=edgecoder-infra
# Public IP or host[:port] to advertise so peers can open channels to you (port 9735).
# Leave empty to advertise nothing (outbound channels still work).
LND_EXTERNAL_IP=
# Host address the lnd REST API (container port 8080) is published on. The bootstrap and
# lncli use it; keep it on the loopback address.
LND_REST_BIND=127.0.0.1:8080

# ---- Optional profiles -------------------------------------------------------------------
# Comma list of compose profiles. "indexer" runs electrs (Electrum server, +0.5 fee-pool
# weight; needs BITCOIN_PRUNE=0 and roughly 2x the chain size in disk). Empty: base bundle.
COMPOSE_PROFILES=
# Host address the Electrum RPC (container port 50001) is published on when the indexer
# profile runs. 0.0.0.0:50001 serves wallets on the internet (then open 50001 too).
ELECTRS_BIND=127.0.0.1:50001

# ---- Postgres (coordinator database; compose network only) -------------------------------
POSTGRES_USER=edgecoder
# Generated by the bootstrap. DATABASE_URL is assembled from these three in the compose file.
POSTGRES_PASSWORD=
POSTGRES_DB=edgecoder

# ---- Coordinator -------------------------------------------------------------------------
# URL agents and peer coordinators use to reach this host's port 4301 (put TLS in front).
COORDINATOR_PUBLIC_URL=http://CHANGE-ME.example:4301
# Portal this coordinator registers with and reports to.
PORTAL_SERVICE_URL=https://edgecoder.io
# Service token the portal operator issues for your coordinator (required in production).
PORTAL_SERVICE_TOKEN=
# Token from the network operator that lets this coordinator join the existing mesh.
COORDINATOR_REGISTRATION_TOKEN=
# Comma list of coordinators to peer with at start.
COORDINATOR_BOOTSTRAP_URLS=https://edgecoder-seed.fly.dev
# Generated by the bootstrap. Agents present it as x-mesh-token; give it to nobody else.
MESH_AUTH_TOKEN=
# Generated by the bootstrap. Control plane admin token (port 4303, loopback only).
ADMIN_API_TOKEN=
# Generated by the bootstrap. Inference service token (port 4302, loopback only).
INFERENCE_AUTH_TOKEN=
# Generated by the bootstrap. HMAC secret for payment webhooks.
PAYMENT_WEBHOOK_SECRET=
# false until lnd has a funded channel; then true so the coordinator pays and gets paid.
ECONOMY_PAYMENTS_ENABLED=false

# ---- Fee pool (how you get paid; see docs/infra-node.md) --------------------------------
# Portal account id that owns this host. Its wallet receives the fee-pool share.
INFRA_HOST_ACCOUNT_ID=
# Lightning address (user@domain) payouts are sent to; usually one served by this lnd.
INFRA_HOST_LIGHTNING_ADDRESS=
# Derived from COMPOSE_PROFILES by the bootstrap: services declared in the heartbeat.
INFRA_HOST_SERVICES=coordinator,bitcoind,lightning
