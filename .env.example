# Listen address (default 127.0.0.1). Containers/Fly/LAN setups: HOST=0.0.0.0
HOST=

# Database
POSTGRES_USER=edgecoder
POSTGRES_PASSWORD=changeme
POSTGRES_DB=edgecoder

# Coordinator
COORDINATOR_MESH_TOKEN=
ADMIN_API_TOKEN=

# Lightning payments — LIGHTNING_PROVIDER=lnd|cln is required in production.
# Local dev with the auto-settling mock: LIGHTNING_PROVIDER=mock + ALLOW_MOCK_LIGHTNING=1
# No Lightning node yet? ECONOMY_PAYMENTS_ENABLED=false (payment routes return 503)
LIGHTNING_PROVIDER=
LND_REST_URL=
LND_MACAROON_HEX=
# lnd's tls.cert, base64 — pins it as the only CA for LND_REST_URL (alternative: NODE_EXTRA_CA_CERTS)
LND_TLS_CERT_BASE64=
CLN_REST_URL=
CLN_API_TOKEN=
ALLOW_MOCK_LIGHTNING=
ECONOMY_PAYMENTS_ENABLED=
# Required in production: HMAC key for /economy/payments/webhook (x-payment-signature: sha256=...)
PAYMENT_WEBHOOK_SECRET=

# Portal
PORTAL_SERVICE_TOKEN=
RESEND_API_KEY=
WALLET_SECRET_PEPPER=

# DNS auto-registration (GoDaddy) — set via Fly secrets, never commit values
GODADDY_API_KEY=
GODADDY_API_SECRET=
DNS_BASE_DOMAIN=edgecoder.io
DNS_COORDINATOR_PREFIX=coord

# OAuth (optional)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=

# Payout safeguards (coordinator; docs/going-to-mainnet.md)
# Hot-wallet caps in sats; 0 = no cap. Unset on BITCOIN_NETWORK=bitcoin means 100000 / 500000 / 2000000,
# unset elsewhere means no cap. Over-limit payouts are rejected and logged as security events.
PAYOUT_MAX_SINGLE_SATS=
PAYOUT_MAX_ACCOUNT_DAILY_SATS=
PAYOUT_MAX_GLOBAL_DAILY_SATS=
# Kill switch: 1 halts withdrawals, auto payouts and fee-pool distribution on this instance (purchases keep
# working); it cannot be lifted over the API. Toggle the shared flag with POST /admin/payouts/pause.
PAYOUTS_PAUSED=
# Ledger vs Lightning node reconciliation; a mismatch auto-pauses payouts. 0 disables the timer (default 600000, min 60000).
PAYOUT_RECONCILE_MS=
# Slack per check in sats (default 1000) and how far back the first run after a start reads node payments (ms, default 86400000).
PAYOUT_RECONCILE_TOLERANCE_SATS=
PAYOUT_RECONCILE_LOOKBACK_MS=
# Optional: POSTed a JSON summary (no secrets) when reconciliation alerts or trips.
PAYOUT_ALERT_WEBHOOK_URL=
# Dev only: starting balance of the mock Lightning wallet, so reconciliation has something to compare.
MOCK_LIGHTNING_BALANCE_SATS=

# Request signing, mesh and infrastructure-host attestation (coordinator; docs/going-to-mainnet.md)
# Signed agent requests are bound to the raw body hash; nonces live in Postgres when DATABASE_URL is set.
# true refuses /mesh/ws connections without a signed bind (set once every agent build signs it).
MESH_WS_REQUIRE_SIGNED=
# Coordinators whose fee pool this host also heartbeats to (signed with COORDINATOR_PRIVATE_KEY_PEM).
INFRA_HOST_REPORT_URLS=
# Lightning node id (lncli getinfo identity_pubkey) so remote coordinators can attest the lightning service.
INFRA_HOST_LIGHTNING_NODE_ID=
# Where this coordinator checks its own electrs before counting it (default electrs:50001).
INFRA_HOST_ELECTRS_ENDPOINT=
# 1 = service probes may target private addresses (local test networks only).
HOST_ATTEST_ALLOW_PRIVATE=

# Agent trust in coordinator keys (docs/receipts-and-trust.md). tofu (default) | strict | open.
# strict needs TRUSTED_COORDINATOR_KEYS=peerId:fingerprint,... (GET /identity -> trustEntry).
EDGECODER_TRUST_MODE=
TRUSTED_COORDINATOR_KEYS=
