{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "EdgeCoder",
  "version": "1.4.77",
  "identifier": "io.edgecoder.desktop",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run bundle-agent && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "EdgeCoder",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 20 }
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "frame-src": "http://127.0.0.1:4306",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "worker-src": "'self' blob:",
        "img-src": "'self' data: blob: https://avatars.githubusercontent.com",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:4301 http://127.0.0.1:4302 http://127.0.0.1:4304 http://127.0.0.1:11434 http://localhost:11434 http://127.0.0.1:11435 http://localhost:11435 ws://127.0.0.1:4301 ws://127.0.0.1:4302 ws://127.0.0.1:4304 https://edgecoder.io https://*.edgecoder.io https://coordinator.edgecoder.io"
      },
      "devCsp": "default-src 'self' 'unsafe-inline' 'unsafe-eval'; script-src 'self' 'unsafe-inline' 'unsafe-eval' http://localhost:1420 blob:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; img-src 'self' data: blob: https:; connect-src 'self' ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:* ws://localhost:* https:",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "dmg",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/agent": "agent"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["edgecoder"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE3MkQxMDI2RDM0NjgyOTMKUldTVGdrYlRKaEF0Ri96enlQZzhvQU5tclkzMmUwMEdRbkdvYmRXSzlnb1dIblovWUg4cmRwMkwK",
      "endpoints": [
        "https://github.com/codyrs82/Edgecoder/releases/download/desktop-updates/latest.json"
      ]
    }
  }
}
