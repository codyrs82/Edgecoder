# /etc/edgecoder/vllm-<instance>.env: read by edgecoder-vllm@<instance>.service.
# install-vllm.sh writes one from a profile; edit it, then `systemctl restart edgecoder-vllm@0`.
# The agent instance's /etc/edgecoder/agent-<instance>.env then gets:
#   EDGECODER_ENGINE=vllm
#   VLLM_URL=http://127.0.0.1:8000
#   VLLM_MODEL=<VLLM_MODEL_ID below>
#   VLLM_MAX_SLOTS=<slots, see docs/inference-engines.md>

# ---- profile a16x2: 2x NVIDIA A16 16 GB (compute capability 8.6), qwen3-coder:30b ----
# AWQ 4-bit weights (16.8 GB) split over both cards (tensor parallel 2), 64K context.
# KV cache ~90K tokens at fp16: 2 calls of 32K at once, more when calls are shorter.
VLLM_MODEL_ID=QuantTrio/Qwen3-Coder-30B-A3B-Instruct-AWQ
VLLM_PORT=8000
CUDA_VISIBLE_DEVICES=0,1
VLLM_ARGS="--tensor-parallel-size 2 --max-model-len 65536 --gpu-memory-utilization 0.92 --max-num-seqs 8 --max-num-batched-tokens 4096 --enable-prefix-caching --enable-auto-tool-choice --tool-call-parser qwen3_xml"
# Weights are downloaded by install-vllm.sh --download; starting offline avoids a Hub call per start.
HF_HUB_OFFLINE=1

# ---- profile a100-80: 1x NVIDIA A100 80 GB (compute capability 8.0), qwen3-coder:30b ----
# VLLM_MODEL_ID=Qwen/Qwen3-Coder-30B-A3B-Instruct-FP8
# VLLM_PORT=8000
# CUDA_VISIBLE_DEVICES=0
# VLLM_ARGS="--max-model-len 65536 --gpu-memory-utilization 0.92 --max-num-seqs 32 --enable-prefix-caching --enable-auto-tool-choice --tool-call-parser qwen3_xml"
# HF_HUB_OFFLINE=1

# ---- single-card profiles a100-40, gpu-48gb, gpu-24gb: see install-vllm.sh for their VLLM_ARGS ----
# (AWQ weights, CUDA_VISIBLE_DEVICES=0; `edgecoder-install apply --vllm-profile auto` picks one by GPU memory)
