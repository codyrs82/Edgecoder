# EdgeCoder agent runtime environment
AGENT_ID=linux-agent-001
AGENT_OS=linux
AGENT_MODE=swarm-only
AGENT_REGISTRATION_TOKEN=<token-from-portal-node-enrollment>
COORDINATOR_URL=https://coordinator.edgecoder.io
# Coordinator trust: with an https://*.edgecoder.io COORDINATOR_URL the agent defaults to
# EDGECODER_TRUST_MODE=strict with the seeds' keys (src/trust/seed-keys.ts). For your own
# coordinator list its trustEntry (GET /identity) here; EDGECODER_TRUST_MODE=tofu pins on first use.
# TRUSTED_COORDINATOR_KEYS=
# EDGECODER_TRUST_MODE=strict
MESH_AUTH_TOKEN=<mesh-token>
LOCAL_MODEL_PROVIDER=edgecoder-local
