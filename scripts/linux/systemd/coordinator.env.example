# EdgeCoder coordinator runtime environment (/etc/edgecoder/coordinator.env, chmod 600).
# docs/agent-and-coordinator-install.md, "Install additional coordinators", explains each step.
NODE_ENV=production
# Your coordinator's public https URL (behind your TLS reverse proxy; the process listens on 127.0.0.1:4301).
COORDINATOR_PUBLIC_URL=https://coordinator.example.com
# The node ID you enrolled in the portal (nodeKind=coordinator) and the token it returned.
COORDINATOR_PEER_ID=<enrolled-node-id>
COORDINATOR_REGISTRATION_TOKEN=<token-from-portal-node-enrollment>
# Existing coordinators to peer with, comma separated.
COORDINATOR_BOOTSTRAP_URLS=https://coordinator.edgecoder.io
# Each existing coordinator's trustEntry (from its public GET /identity) followed by @<its URL>, comma separated.
MESH_PEER_ALLOWLIST=<peerId:fingerprint@https://existing-coordinator>
# Admit peers by their signed requests (their key on MESH_PEER_ALLOWLIST) without a shared mesh token.
MESH_TOKEN_REQUIRED_FOR_PEERS=false
# Portal the coordinator validates nodes with. It signs its calls with COORDINATOR_PRIVATE_KEY_PEM (the
# first one also carries COORDINATOR_REGISTRATION_TOKEN, which binds the key), and accepts portal calls
# signed for it with the portal's public key. No portal token is needed.
PORTAL_SERVICE_URL=https://portal.edgecoder.io
PORTAL_ACTION_VERIFY_KEYS=<portal public key from the portal operator>
# Your own mesh token (agents never get it). Peers you do not share it with admit you by signature.
MESH_AUTH_TOKEN=<random, e.g. openssl rand -hex 32>
# The reverse proxy on this host, so client addresses are logged instead of the proxy's.
# Proxied requests are never treated as local callers either way.
COORDINATOR_TRUST_PROXY=127.0.0.1
# An agent on this machine registers with its own AGENT_REGISTRATION_TOKEN (portal enrollment).
# true: agents connecting directly to 127.0.0.1:4301 (not through the proxy) may register without one.
COORDINATOR_LOOPBACK_SELF_REGISTRATION=false
# Your own values.
DATABASE_URL=postgres://edgecoder:<password>@127.0.0.1:5432/edgecoder
ADMIN_API_TOKEN=<random, e.g. openssl rand -hex 32>
PAYMENT_WEBHOOK_SECRET=<random, e.g. openssl rand -hex 32>
# Set before the first start; it is recorded in the database (bitcoin | testnet | signet).
BITCOIN_NETWORK=bitcoin
# false until you run your own Lightning node (then LIGHTNING_PROVIDER=lnd|cln and its settings).
ECONOMY_PAYMENTS_ENABLED=false
# Stable identity: openssl genpkey -algorithm ed25519, pasted as one double-quoted multi-line value.
COORDINATOR_PRIVATE_KEY_PEM="<ed25519-private-key-pem>"
