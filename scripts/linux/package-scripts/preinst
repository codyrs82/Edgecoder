#!/usr/bin/env bash

set -euo pipefail

if ! command -v node >/dev/null 2>&1; then
  echo "EdgeCoder requires Node.js 22+ to be installed first."
  echo "Install Node.js and try again:"
  echo "  https://nodejs.org/en/download (official release archive or your distribution's package)"

  exit 1
fi

NODE_MAJOR="$(node -p "process.versions.node.split('.')[0]")"
if [[ "$NODE_MAJOR" -lt 22 ]]; then
  echo "Detected Node.js $(node -v). EdgeCoder requires Node.js 22+."
  exit 1
fi

exit 0
